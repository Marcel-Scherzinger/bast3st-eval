use std::{collections::BTreeMap, hash::Hash};

use super::runtime_any::*;
use crate::{
    catchable::cerr,
    spec::{ActionEntity, CriterionEntity, Entity, EntityId, PrimitiveValue, ValueReference},
};

pub type AllRuntimeValues = BTreeMap<EntityId<Entity>, RuntimeAny>;

pub type Pushable<R> = Box<dyn for<'a> FnOnce(&'a AllRuntimeValues) -> Machine<R>>;

pub enum InnerMachine<R> {
    Final(R),
    Pushable(Pushable<R>),
    Catchable(cerr),
}
pub enum FatalError {
    DeliveredValueStillMissing(EntityId<Entity>),
}

pub struct Machine<R> {
    /// values that are missing and need to be computed first before this
    /// machine can continue
    missing_values: Vec<EntityId<Entity>>,
    /// other nodes whose value changes will affect the value of this computation
    dependencies: Vec<EntityId<Entity>>,
    inner: Result<InnerMachine<R>, FatalError>,
}
impl FatalError {
    fn into_machine<R>(self) -> Machine<R> {
        Machine {
            missing_values: vec![],
            dependencies: vec![],
            inner: Err(self),
        }
    }
}

impl<R: Hash> From<R> for Machine<R> {
    fn from(value: R) -> Self {
        Self {
            missing_values: vec![],
            dependencies: vec![],
            inner: Ok(InnerMachine::Final(value)),
        }
    }
}

impl<R> From<cerr> for Machine<R> {
    fn from(value: cerr) -> Self {
        Self {
            missing_values: vec![],
            dependencies: vec![],
            inner: Ok(InnerMachine::Catchable(value)),
        }
    }
}

pub trait PossibleRuntimeValue<RuntimeT> {}

macro_rules! impl_possible {
    ( $type: ty: $($rt: ty),+ $(,)?) => {
        $(
            impl PossibleRuntimeValue<$rt> for $type {}
        )+
    };
}

impl<S, RT> PossibleRuntimeValue<&RT> for S where S: PossibleRuntimeValue<RT> {}

impl_possible!(EntityId<Entity>:
    //
    RuntimeAny,
    //
    RuntimeValue, PrimitiveValue, Array, Mapping,
    //
    RuntimeAction,
    RuntimeCriterion,
    //
);
impl_possible!(EntityId<ActionEntity>: RuntimeAction, );
impl_possible!(EntityId<CriterionEntity>: RuntimeCriterion, );

impl_possible!(ValueReference:
    //
    RuntimeValue, PrimitiveValue, Array, Mapping,
    //
);

pub trait Specialize {
    type Out<'a>;
    fn from_any<'a>(v: &'a RuntimeAny) -> Result<Self::Out<'a>, cerr>;
}

impl Specialize for &RuntimeAction {
    type Out<'a> = &'a RuntimeAction;

    fn from_any<'a>(v: &'a RuntimeAny) -> Result<Self::Out<'a>, cerr> {
        match v {
            RuntimeAny::Action(a) => Ok(a),
            _ => Err(cerr::typing_notAction),
        }
    }
}
impl Specialize for RuntimeAction {
    type Out<'a> = RuntimeAction;
    fn from_any<'a>(v: &'a RuntimeAny) -> Result<Self::Out<'a>, cerr> {
        match v {
            RuntimeAny::Action(a) => Ok(a.clone()),
            _ => Err(cerr::typing_notAction),
        }
    }
}

impl Specialize for &RuntimeCriterion {
    type Out<'a> = &'a RuntimeCriterion;
    fn from_any<'a>(v: &'a RuntimeAny) -> Result<Self::Out<'a>, cerr> {
        match v {
            RuntimeAny::Criterion(a) => Ok(a),
            _ => Err(cerr::typing_notAction),
        }
    }
}
impl Specialize for RuntimeCriterion {
    type Out<'a> = RuntimeCriterion;
    fn from_any<'a>(v: &'a RuntimeAny) -> Result<Self::Out<'a>, cerr> {
        match v {
            RuntimeAny::Criterion(a) => Ok(a.clone()),
            _ => Err(cerr::typing_notAction),
        }
    }
}

pub trait AndThen<E, RuntimeT>: PossibleRuntimeValue<RuntimeT>
where
    RuntimeT: Specialize,
{
    fn and_then1<R>(
        &self,
        closure: impl for<'a> FnOnce(RuntimeT::Out<'a>) -> Machine<R> + 'static,
    ) -> Machine<R>;
}

impl<E, RuntimeT> AndThen<E, RuntimeT> for EntityId<E>
where
    EntityId<E>: PossibleRuntimeValue<RuntimeT>,
    RuntimeT: Specialize, // RuntimeT: for<'a> TryFrom<&'a RuntimeAny, Error = cerr>,
{
    fn and_then1<R>(
        &self,
        closure: impl for<'a> FnOnce(RuntimeT::Out<'a>) -> Machine<R> + 'static,
    ) -> Machine<R> {
        let id: EntityId<Entity> = self._cast_id();
        let on_push = move |val: &AllRuntimeValues| {
            let Some(delivered) = val.get(&id) else {
                return FatalError::DeliveredValueStillMissing(id).into_machine();
            };
            let needed = match RuntimeT::from_any(delivered) {
                Ok(o) => o,
                Err(e) => return e.into(),
            };
            closure(needed)
        };
        Machine {
            missing_values: vec![id],
            dependencies: vec![],
            inner: Ok(InnerMachine::Pushable(Box::new(on_push))),
        }
    }
}

impl<E> EntityId<E> {
    fn and_then_alt<RuntimeT, R>(
        &self,
        closure: impl for<'a> FnOnce(RuntimeT::Out<'a>) -> Machine<R> + 'static,
    ) -> Machine<R>
    where
        RuntimeT: Specialize,
        Self: AndThen<E, RuntimeT> + PossibleRuntimeValue<RuntimeT>,
    {
        self.and_then1(closure)
    }
}

impl<E> EntityId<E> {
    fn and_then<Out, Closure, R>(&self, closure: Closure) -> Machine<R>
    where
        Out: Specialize,
        Out: for<'a> Specialize<Out<'a> = Out>,
        Self: AndThen<E, Out> + PossibleRuntimeValue<Out>,
        Closure: for<'a> FnOnce(Out) -> Machine<R> + 'static,
    {
        self.and_then1(closure)
    }
}

fn eval_if_then_else(
    if_: EntityId<CriterionEntity>,
    then_: EntityId<ActionEntity>,
    else_: EntityId<ActionEntity>,
) -> Machine<RuntimeAction> {
    if_.and_then(move |if_: &RuntimeCriterion| {
        if if_.0 {
            then_.and_then(|then_: RuntimeAction| then_.into())
        } else {
            else_.and_then(|else_: RuntimeAction| else_.clone().into())
        }
    })
}
