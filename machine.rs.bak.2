use std::{borrow::Cow, collections::BTreeMap, hash::Hash};

use super::runtime_any::*;
use crate::{
    catchable::cerr,
    spec::{ActionEntity, CriterionEntity, Entity, EntityId, PrimitiveValue, ValueReference},
};

pub type AllRuntimeValues = BTreeMap<EntityId<Entity>, RuntimeAny>;

pub type Pushable<R> = Box<dyn for<'a> FnOnce(&'a AllRuntimeValues) -> Machine<R>>;

pub enum InnerMachine<R> {
    Final(R),
    Pushable(Pushable<R>),
    Catchable(cerr),
}
pub enum FatalError {
    DeliveredValueStillMissing(EntityId<Entity>),
}

pub struct Machine<R> {
    /// values that are missing and need to be computed first before this
    /// machine can continue
    missing_values: Vec<EntityId<Entity>>,
    /// other nodes whose value changes will affect the value of this computation
    dependencies: Vec<EntityId<Entity>>,
    inner: Result<InnerMachine<R>, FatalError>,
}
impl FatalError {
    fn into_machine<R>(self) -> Machine<R> {
        Machine {
            missing_values: vec![],
            dependencies: vec![],
            inner: Err(self),
        }
    }
}

impl<R: Hash> From<R> for Machine<R> {
    fn from(value: R) -> Self {
        Self {
            missing_values: vec![],
            dependencies: vec![],
            inner: Ok(InnerMachine::Final(value)),
        }
    }
}

impl<'a, R: Hash + Clone> From<Cow<'a, R>> for Machine<R> {
    fn from(value: Cow<'a, R>) -> Self {
        Self {
            missing_values: vec![],
            dependencies: vec![],
            inner: Ok(InnerMachine::Final(value.into_owned())),
        }
    }
}

impl<R> From<cerr> for Machine<R> {
    fn from(value: cerr) -> Self {
        Self {
            missing_values: vec![],
            dependencies: vec![],
            inner: Ok(InnerMachine::Catchable(value)),
        }
    }
}

pub trait PossibleRuntimeValue<RuntimeT> {}

macro_rules! impl_possible {
    ( $type: ty: $($rt: ty),+ $(,)?) => {
        $(
            impl PossibleRuntimeValue<$rt> for $type {}
        )+
    };
}

impl<'a, E, T: Clone> PossibleRuntimeValue<Cow<'a, T>> for E where E: PossibleRuntimeValue<T> {}

// impl<S, RT> PossibleRuntimeValue<&RT> for S where S: PossibleRuntimeValue<RT> {}

impl_possible!(EntityId<Entity>:
    //
    RuntimeAny,
    //
    RuntimeValue, PrimitiveValue, Array, Mapping,
    //
    RuntimeAction,
    RuntimeCriterion,
    //
);
impl_possible!(EntityId<ActionEntity>: RuntimeAction, );
impl_possible!(EntityId<CriterionEntity>: RuntimeCriterion, );

impl_possible!(ValueReference:
    //
    RuntimeValue, PrimitiveValue, Array, Mapping,
    //
);

pub trait AndThenO<E, RuntimeT: MainType>: PossibleRuntimeValue<RuntimeT> {
    fn and_then_o<R>(
        &self,
        closure: impl for<'a> FnOnce(Cow<'a, RuntimeT>) -> Machine<R> + 'static,
    ) -> Machine<R>;
}

pub trait Specialize: Clone {
    fn from_any<'a>(any: &'a RuntimeAny) -> Result<Cow<'a, Self>, cerr>
    where
        Self: Sized;
}
impl Specialize for RuntimeAction {
    fn from_any<'a>(any: &'a RuntimeAny) -> Result<Cow<'a, Self>, cerr>
    where
        Self: Sized,
    {
        match any {
            RuntimeAny::Action(o) => Ok(Cow::Borrowed(o)),
            _ => Err(cerr::typing_notAction),
        }
    }
}

pub trait MainType {}
impl MainType for RuntimeAction {}
impl MainType for RuntimeCriterion {}

impl<E, RuntimeT: MainType> AndThenO<E, RuntimeT> for EntityId<E>
where
    EntityId<E>: PossibleRuntimeValue<RuntimeT>,
    RuntimeT: Clone + Specialize,
{
    fn and_then_o<R>(
        &self,
        closure: impl for<'a> FnOnce(Cow<'a, RuntimeT>) -> Machine<R> + 'static,
    ) -> Machine<R> {
        let id: EntityId<Entity> = self._cast_id();
        let on_push = move |val: &AllRuntimeValues| {
            let Some(delivered) = val.get(&id) else {
                return FatalError::DeliveredValueStillMissing(id).into_machine();
            };
            let converted: Cow<'_, RuntimeT> = match RuntimeT::from_any(delivered) {
                Ok(o) => o,
                Err(e) => return e.into(),
            };
            closure(converted)
        };
        Machine {
            missing_values: vec![id],
            dependencies: vec![],
            inner: Ok(InnerMachine::Pushable(Box::new(on_push))),
        }
    }
}

